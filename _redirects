# Cloudflare Pages redirects
# Astro's static build outputs the default locale (en) under /en/ instead
# of the root, even with prefixDefaultLocale: false. Redirect root-level
# paths to their /en/ equivalents so visitors don't hit 404s.
# Rules are matched top-to-bottom; /zh-cn/*, /_astro/*, /pagefind/* and
# root-level static files (og.png, robots.txt, etc.) are never matched.

/              /en/               301
/about         /en/about          301
/archives      /en/archives       301
/search        /en/search         301
/rss.xml       /en/rss.xml        301
/posts         /en/posts          301
/posts/*       /en/posts/:splat   301
/tags          /en/tags           301
/tags/*        /en/tags/:splat    301
